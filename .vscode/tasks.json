{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Environment",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$timer = [System.Diagnostics.Stopwatch]::StartNew(); python -m pip install uv; python -m uv sync --all-extras; python -m uv run playwright install chromium; python -m uv run pre-commit install; $timer.Stop(); Write-Host \"Setup finished in $($timer.Elapsed)\""
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "pytest", "--cov=."]
            ,
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build EXE",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$timer = [System.Diagnostics.Stopwatch]::StartNew(); if (Test-Path build) { Remove-Item -Recurse -Force build/* -ErrorAction SilentlyContinue }; python -m uv run pyinstaller --clean --onedir --name stock_scanner --distpath build/dist --workpath build/work --specpath build/spec src/main.py; Copy-Item -Recurse -Force src/assets build/dist/assets; $timer.Stop(); Write-Host \"Build finished in $($timer.Elapsed)\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "dependsOn": ["Pre-build check"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run GUI Automations",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "python", "-m", "src.core.gui_automations"],
            "problemMatcher": []
        },
        {
            "label": "Lint & Format",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "python -m uv run ruff check . --fix; python -m uv run ruff format ."
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Pre-build check",
            "dependsOn": [
                "Lint & Format",
                "Type check",
                "Import check"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Type check",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "mypy", "."],
            "problemMatcher": []
        },
        {
            "label": "Import check",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "python", "-c", "import src.main"],
            "problemMatcher": []
        }
    ]
}