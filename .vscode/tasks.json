{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Environment",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "pytest", "--cov=."]
            ,
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build EXE",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File",
                "${workspaceFolder}/scripts/build.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "dependsOn": ["Pre-build check"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run GUI Automations",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "python", "-m", "src.core.gui_automations"],
            "problemMatcher": []
        },
        {
            "label": "Lint & Format",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "python -m uv run ruff check . --fix; python -m uv run ruff format ."
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Pre-build check",
            "dependsOn": [
                "Lint & Format",
                "Type check",
                "Import check"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Type check",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "mypy", "."],
            "problemMatcher": []
        },
        {
            "label": "Import check",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "python", "-c", "import src.main"],
            "problemMatcher": []
        }
    ]
}