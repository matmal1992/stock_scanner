{
    "version": "2.0.0",
    "tasks": [
         {
            "label": "Set up environment",
            "type": "shell",
            "command": [
                "python -m pip install uv;",
                "python -m uv sync --all-extras;",
                "python -m uv run playwright install chromium;",
                "python -m uv run pre-commit install"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "python -m uv run pytest --cov=.",
            "problemMatcher": []
        },
        {
            "label": "Build EXE",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Remove-Item -Recurse -Force build/*; python -m uv run pyinstaller --onefile --name stock_scanner --distpath build src/main.py; Copy-Item -Recurse -Force src/assets build/assets"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run gui_automations",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "uv",
                "run",
                "python",
                "-m",
                "src.core.gui_automations"
            ],
            "problemMatcher": []
        },
        {
            "label": "Lint & Format",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "python -m uv run ruff check . --fix; python -m uv run ruff format ."
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Pre-build check",
            "dependsOn": [
                "Lint & Format",
                "Type check",
                "Import check"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "Type check",
            "type": "shell", 
            "command": "python",
            "args": ["-m", "uv", "run", "mypy", "."],
            "problemMatcher": []
        },
        {
            "label": "Import check",
            "type": "shell",
            "command": "python",
            "args": ["-m", "uv", "run", "python", "-c", "import src.main"],
            "problemMatcher": []
        }
    ]
}